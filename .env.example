# Development 
# MONGODB_URI=mongodb://localhost:27017/instapeels-db 
# Production 
MONGODB_URI=
# Developement 
# Authentication 
NEXTAUTH_SECRET=
NODE_ENV=production 
#NEXT_PUBLIC_SITE_URL=http://localhost:3004 
#NEXTAUTH_URL=http://localhost:3004 
# For production, use your domain name here. eg: https://www.instapeels.com 
# Uncomment when uploading to productions 
NEXT_PUBLIC_SITE_URL=https://linknsmile.com 
NEXTAUTH_URL=https://linknsmile.com 
# Email
 GMAIL_EMAIL=
 GMAIL_APP_PASSWORD=
 EMAIL_FROM=
 # Payment 
 RAZORPAY_KEY_ID=
 # Image storage provider (lib/storage/, lib/env.ts imageProviderRequiredEnvVars).
 # IMAGE_PROVIDER picks which vars below are required, fail-fast at
 # startup: "cloudinary" (default) or "bunny".
 IMAGE_PROVIDER=cloudinary

 # Cloudinary (required while IMAGE_PROVIDER=cloudinary; the app's real
 # upload path today, via app/api/upload/route.ts)
 CLOUDINARY_CLOUD_NAME=
 CLOUDINARY_API_KEY=
 CLOUDINARY_API_SECRET=
 CLOUDINARY_URL=

 # Bunny.net (required while IMAGE_PROVIDER=bunny). BUNNY_PULL_ZONE_HOSTNAME
 # must be a bare hostname (no scheme/trailing slash) — next.config.mjs
 # reads it directly and adds it to the allowed image hostnames itself,
 # no separate config needed.
 BUNNY_STORAGE_ZONE=
 BUNNY_STORAGE_API_KEY=
 BUNNY_STORAGE_ENDPOINT=storage.bunnycdn.com
 BUNNY_PULL_ZONE_HOSTNAME=


 MIGRATION_SECRET=

  # Google OAuth (optional — Google sign-in is disabled if these are unset)
 GOOGLE_CLIENT_ID=
 GOOGLE_CLIENT_SECRET=
 
 NEXT_PUBLIC_RAZORPAY_KEY_ID=

 CRON_SECRET=



