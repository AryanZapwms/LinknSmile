# .env.ae.example
#
# Template for the UAE deployment's `shared/.env` file on the VPS
# (/home/ae.linknsmile.com/shared/.env — see Deployment.md's "One-time
# initial server setup" and PROJECT_SOURCE_OF_TRUTH.md §11). Copy this
# file, fill in the real secrets yourself, and place it there — it is
# NEVER committed with real values and is never touched by any deploy.
#
# Every variable below was cross-checked directly against lib/env.ts's
# validateEnv() (required vars) and every other process.env.* read in
# the codebase (optional vars) — not copied blind from .env.example,
# which is itself flagged stale in PROJECT_SOURCE_OF_TRUTH.md §17.

NODE_ENV=production

# ── Always required (lib/env.ts alwaysRequiredEnvVars) ────────────────
# Separate database from India — do NOT point this at the same Mongo
# cluster/db India uses.

MONGODB_URI=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://ae.linknsmile.com
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=**********1*

# Falls back to GMAIL_EMAIL if unset (lib/env.ts) — set explicitly if
# UAE orders/OTP mail should show a different "from" address than the
# Gmail login account itself.

EMAIL_FROM=

# ── Payment gateway (lib/env.ts paymentGatewayRequiredEnvVars) ────────
# UAE uses Tap Payments (developers.tap.company), not Razorpay — see
# PROJECT_SOURCE_OF_TRUTH.md §4.15. PAYMENT_GATEWAY selects which vars
# validateEnv() requires; NEXT_PUBLIC_PAYMENT_GATEWAY is its client-side
# mirror (checkout/vendor-subscription UI branches on it). Razorpay vars
# are intentionally omitted below — they're not required when
# PAYMENT_GATEWAY=tap and this deployment never uses them.

PAYMENT_GATEWAY=tap

NEXT_PUBLIC_PAYMENT_GATEWAY=tap

# Secret-key-only (Bearer auth) — Tap's hosted-redirect checkout has no
# publishable/public key, unlike Razorpay. Use TEST credentials until
# ready to go live (see PROJECT_SOURCE_OF_TRUTH.md §16 item 18 — India
# shipped on Razorpay test keys by accident; don't repeat that here,
# double check this is a LIVE key before real customers can pay).

TAP_SECRET_KEY=

# ── Currency / locale / country (lib/currency.ts, lib/i18n-config.ts) ─

NEXT_PUBLIC_CURRENCY_CODE=AED

# lib/currency.ts's LOCALE is an Intl date/currency FORMATTING locale,
# NOT the UI translation language — those are two independent concepts
# (see lib/i18n-config.ts's own header comment). India's deployment uses
# "en-IN" (English formatting conventions), not a Hindi locale, even
# though Hindi is an available secondary UI language — the same pattern
# applies here: "en-AE" (English formatting for the UAE) is the correct
# value, not "ar-AE". Arabic is enabled as the secondary UI language
# separately, below.

NEXT_PUBLIC_LOCALE=en-AE

# Enables Arabic as the secondary UI language (messages/ar.json already
# exists in the repo) alongside English, which is always on by default.
# See lib/i18n-config.ts — this is Phase 1 i18n (§4.18): only
# components/header.tsx, components/footer.tsx, and app/page.tsx are
# actually translated so far, everything else still renders hardcoded
# English regardless of this setting.

NEXT_PUBLIC_SECONDARY_LOCALE=ar

# Checkout's Country field default (components/checkout-form.tsx) — an
# editable text field, not a dropdown/validator, so this is just the
# pre-filled default a UAE customer sees.

NEXT_PUBLIC_DEFAULT_COUNTRY=United Arab Emirates

# ── Site URLs ───────────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=https://ae.linknsmile.com

# ── Image hosting (next.config.mjs remotePatterns, lib/env.ts) ────────
# Comma-separated hostnames Next/Image is allowed to optimize images
# from, in addition to the always-allowed res.cloudinary.com. Defaults
# to India's own domains if unset — MUST be overridden here or
# self-hosted (non-Cloudinary) images on ae.linknsmile.com will 400.

NEXT_PUBLIC_IMAGE_HOSTNAMES=ae.linknsmile.com

# ── Cloudinary (optional per lib/env.ts, but the app's real upload path) ─
# Can reuse India's Cloudinary account (just a media CDN, folders don't
# collide with DB records) or use a dedicated UAE account/folder — your
# call. Leave blank only if you're certain no vendor/admin will ever
# upload an image on this deployment.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# ── Cron auth (app/api/cron/*) ─────────────────────────────────────────
# Required so the UAE crontab (set up separately on the VPS, pointed at
# https://ae.linknsmile.com/api/cron/*) can authenticate. Must be a
# DIFFERENT value than India's CRON_SECRET — do not reuse it.
CRON_SECRET=

# ── Google OAuth (optional — Google sign-in disabled if unset) ────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Order-notification email (optional, app/api/orders/route.ts) ──────
# If set, a copy of every new-order notification email is also sent
# here. Leave blank to disable.
ADMIN_EMAIL=

# ── Tracking / monitoring IDs (optional, lib/site-config.ts) ──────────
# All default to INDIA's live Sentry project / FB Pixel / GTM container /
# Google Ads IDs (see lib/env.ts) if left unset here — that would mix
# UAE traffic into India's analytics. Strongly recommended to set up
# and fill in dedicated UAE properties for each of these rather than
# leaving them blank/default.

NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
